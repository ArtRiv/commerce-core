# Copy to .env and fill in. .env is gitignored; this file is the checked-in
# documentation of what the app needs to run.

# ---------------------------------------------------------------------------
# Required — the app will not boot without these.
# ---------------------------------------------------------------------------

# Which environment this is. Only "development" and "test" may run without
# Stripe configured; anything else — including leaving this unset — makes the
# Stripe variables below mandatory and refuses to boot without them.
#
# That asymmetry is deliberate. Without Stripe the app binds a fake payment
# provider whose webhook does NOT verify signatures, so anyone who can reach
# /payments/webhook could mark orders paid. That is fine on a laptop and
# catastrophic anywhere else, so "unset" has to mean "real", not "dev".
#
# The npm start scripts set this to development for you; a deployment must set
# it to production itself.
NODE_ENV="development"

# Postgres connection string. This project uses Supabase, but any Postgres
# works. Prisma connects through it as the table owner.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Secret for signing access-token JWTs (HS256). Use a long random string;
# anyone who has it can mint valid tokens. Generate one with e.g.
# `openssl rand -base64 48`.
JWT_SECRET="change-me-to-a-long-random-string"

# Access-token lifetime. Optional — defaults to 15m. Format is the `ms`
# library's (e.g. "15m", "1h").
JWT_ACCESS_TTL="15m"

# --- Email (Resend) ---------------------------------------------------------
# Required because email verification gates every password login, so an app
# that cannot send mail is broken rather than degraded.

# https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Sender address. Without a verified domain, use Resend's sandbox sender —
# but it can only deliver to the email your Resend account is registered
# under. A verified domain is what lets you mail real users.
#   MAIL_FROM="Commerce Core <onboarding@resend.dev>"
MAIL_FROM="Commerce Core <onboarding@resend.dev>"

# --- URLs -------------------------------------------------------------------
# Two different origins, deliberately.

# The FRONTEND base. Emailed verification/reset links point here — they are
# opened in a browser and land on pages that read the token and call the API.
# Until a frontend exists this is a placeholder; the links will 404 in a
# browser but every automated test still passes.
APP_URL="http://localhost:5173"

# THIS API's public base. Google's OAuth callback is a route on this service,
# so the callback URL is built from this. In local dev the API is :3000.
API_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional in development, REQUIRED in production.
# ---------------------------------------------------------------------------

# --- Payments (Stripe) ------------------------------------------------------
# Without both of these the app boots with FakePaymentProvider and logs a
# warning — but ONLY when NODE_ENV is development or test, so a fresh clone
# still has a working checkout with no Stripe account. Anywhere else, missing
# either one refuses to start: a store that quietly stops charging (or that
# accepts unsigned webhooks) is worse than one that will not boot.
#
# They come as a pair on purpose. A secret key without a webhook secret can
# take money and can never confirm it did, because every event it receives
# fails verification.

# https://dashboard.stripe.com/apikeys — use the test key (sk_test_...) locally.
STRIPE_SECRET_KEY=""

# Signing secret of the webhook endpoint, NOT an API key. Each endpoint has its
# own. Local development: `stripe listen --forward-to localhost:3000/payments/webhook`
# prints one (whsec_...) for the duration of the session.
STRIPE_WEBHOOK_SECRET=""

# Currency for every charge, ISO 4217. Optional — defaults to brl. One currency
# per instance: orders store cents with no currency column.
STRIPE_CURRENCY="brl"

# Default checkout UI when a request does not ask for one. Optional — defaults
# to "hosted".
#   hosted   — the API returns a URL; the buyer is sent to Stripe's page.
#   embedded — the API returns a client secret; the storefront renders its own
#              checkout page and mounts Stripe's payment form inside it.
# Either way the storefront owns layout and branding, and Stripe owns the card
# fields, which is what keeps PCI scope at SAQ-A.
STRIPE_CHECKOUT_MODE="hosted"

# ---------------------------------------------------------------------------
# Optional — leave blank to run without the feature.
# ---------------------------------------------------------------------------

# Google sign-in. Without both, the app boots fine and the /auth/google routes
# answer 503. https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI in the Google console MUST exactly match
# `${API_URL}/auth/google/callback` — e.g. http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
