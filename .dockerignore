# Keep the build context small and, more importantly, keep secrets out of it.
#
# .env* is first for that second reason: a build context is not a private
# place. Anything copied into a layer is readable by anyone who pulls the
# image, and `COPY . .` in some future edit of the Dockerfile would sweep a
# .env in without anyone noticing. Same wide glob as .gitignore, same argument.
.env*
!.env.example

.git
.github
.husky
node_modules
dist
coverage
src/generated

# Not needed to build or run the image.
test
docs
claude
*.md
!README.md
.vscode
.idea
eslint.config.mjs
.prettierrc
openapi.json
