/// A variant in a cart: reference + quantity, nothing else. No price here on
/// purpose — carts show live catalog prices; snapshotting happens at checkout,
/// in OrderItem. The variant FK cascades as theoretical hygiene only: the
/// catalog never hard-deletes products (DELETE archives), and v1 has no route
/// that removes a variant.
///
/// The line points at a VARIANT, and does not carry the product id alongside:
/// the variant already names its product, and two columns that must agree are
/// two columns that can disagree. Two sizes of one shirt are two lines, which
/// is exactly right.
model CartItem {
  id     String @id @default(uuid())
  cartId String @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  @@unique([cartId, variantId])
  @@map("cart_items")
}
