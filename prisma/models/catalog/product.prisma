/// Lifecycle of a product. The public storefront only ever sees ACTIVE;
/// DRAFT and ARCHIVED require the products.read permission. There is no
/// hard delete — orders will reference products, so DELETE archives.
/// See docs/specs/catalog.md.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id String @id @default(uuid())

  name String

  /// URL identity for storefronts. Unique, generated from the name when not
  /// provided. Mutable — the immutable id is the stable alternative for links
  /// that must not break.
  slug String @unique

  description String?

  /// Integer cents, always > 0 (enforced at the DTO). Never a float: money
  /// arithmetic in floats drifts, and Postgres NUMERIC buys nothing here
  /// while a single currency (BRL) is all v1 supports.
  priceCents Int @map("price_cents")

  /// Plain URLs; upload/storage is out of v1's scope (docs/specs/catalog.md).
  imageUrls String[] @map("image_urls")

  status ProductStatus @default(DRAFT)

  /// Unit weight in grams, for freight quoting (docs/specs/shipping.md).
  /// Optional because every product that existed before shipping was built
  /// starts without one: refusing to sell until someone fills them in would
  /// have taken the whole catalogue down. A missing weight falls back to
  /// SHIPPING_DEFAULT_WEIGHT_GRAMS, which is a controlled lie — the store
  /// eats the difference on a heavy product nobody weighed.
  ///
  /// No dimensions in v1; cubic weight is a deferred decision.
  weightGrams Int? @map("weight_grams")

  /// The sellable units. ALWAYS at least one — a product with none would be
  /// unbuyable, and the fork "product with variants / product without" is what
  /// this relation exists to prevent (docs/specs/product-variants.md).
  ///
  /// Stock used to be a column here. It is not any more: it lives on the
  /// variant, and `ProductResponse.stockQuantity` is the sum across these,
  /// computed on read so it cannot drift from what checkout decrements.
  variants ProductVariant[]

  categories ProductCategory[]

  /// Back-relation for the orders module (docs/specs/orders.md). Order items
  /// Restrict product deletion — one more reason DELETE archives. Cart lines
  /// point at a VARIANT, so there is no cartItems back-relation here.
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("products")
}
