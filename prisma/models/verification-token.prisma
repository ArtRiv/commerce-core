/// Why one model instead of two: an email-verification token and a
/// password-reset token are the same object — a single-use, expiring, hashed
/// secret mailed to an address to prove the holder reads it. Only the lifetime
/// and what consuming it authorises differ. Splitting them would duplicate the
/// issue/consume logic, and the two copies would drift.
enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id String @id @default(uuid())

  /// SHA-256 of the token. Same reasoning as RefreshToken.tokenHash: the token
  /// is CSPRNG output, so there is nothing to brute-force and no reason to pay
  /// argon2's cost — and a deterministic digest can be looked up by index,
  /// which a salted hash cannot.
  tokenHash String @unique @map("token_hash")

  purpose VerificationTokenPurpose

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 24h for verification, 1h for reset — see docs/specs/auth.md.
  expiresAt DateTime @map("expires_at")

  /// Single use. No revokedAt twin like RefreshToken has: there is no family
  /// here, so nothing to sweep — a spent token is simply spent.
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("verification_tokens")
}
